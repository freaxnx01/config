{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "black": "#262B44",
    "blue": "#4B95E9",
    "green": "#59C9A5",
    "orange": "#F07623",
    "red": "#D81E5B",
    "sapling": "#a6d189",
    "white": "#E0DEF4",
    "yellow": "#F3AE35"
  },
  "accent_color": "32",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "  {{ .HostName }} ",
          "foreground": "p:white",
          "leading_diamond": "",
          "background": "p:black",
          "type": "session",
          "style": "diamond"
        },
        {
          "options": {
            "dir_length": 3,
            "folder_separator_icon": "",
            "style": "fish"
          },
          "template": "{{ if .Segments.Git.Dir }}  <i><b>{{ .Segments.Git.RepoName }}{{ if .Segments.Git.IsWorkTree }} {{ end }}</b></i>{{ $rel := .Segments.Git.RelativeDir }}{{ if $rel }}  {{ .Format $rel }}{{ end }}{{ else }}  {{ path .Path .Location }}{{ end }} ",
          "foreground": "p:white",
          "leading_diamond": "<parentBackground,background></>",
          "background": "p:orange",
          "type": "path",
          "style": "diamond"
        },
        {
          "type": "text",
          "style": "plain",
          "background": "transparent",
          "foreground": "p:orange",
          "template": "{{ if not .Segments.Git.Dir }}{{ end }}"
        },
        {
          "options": {
            "branch_icon": "",
            "fetch_status": true
          },
          "template": " {{ if .UpstreamURL }}{{ url .UpstreamIcon .UpstreamURL }} {{ end }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ nospace .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} ",
          "foreground": "p:black",
          "leading_diamond": "<parentBackground,background></>",
          "trailing_diamond": "",
          "background": "p:green",
          "type": "git",
          "style": "diamond",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:black{{ end }}",
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}p:white{{ end }}"
          ],
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:red{{ end }}",
            "{{ if gt .Ahead 0 }}#49416D{{ end }}",
            "{{ if gt .Behind 0 }}#7A306C{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "leading_diamond": "",
          "template": " 󰯉 {{ .Model.DisplayName }} ",
          "foreground": "p:white",
          "background": "p:blue",
          "type": "claude",
          "style": "diamond"
        },
        {
          "leading_diamond": "<background,parentBackground></>",
          "template": "  Ctx {{ .FormattedTokens }}{{ if .ContextWindow.ContextWindowSize }}/{{ div .ContextWindow.ContextWindowSize 1000 }}K{{ end }} ({{ .TokenUsagePercent.String }}%) ",
          "foreground": "p:white",
          "background": "accent",
          "type": "claude",
          "style": "diamond"
        },
        {
          "leading_diamond": "<background,parentBackground></>",
          "trailing_diamond": "",
          "template": "{{ if .FiveHourUsage }} Sess {{ .FiveHourUsage.String }}% ↺ {{ .FiveHourResetsAt | date \"15:04\" }}{{ end }}{{ if .SevenDayUsage }} · Week {{ .SevenDayUsage.String }}% ↺ {{ .SevenDayResetsAt | date \"Jan 2 15:04\" }}{{ end }}{{ if or .FiveHourUsage .SevenDayUsage }} {{ end }}",
          "foreground": "p:white",
          "background": "#49416D",
          "type": "claude",
          "style": "diamond"
        },
        {
          "options": {
            "charged_icon": " ",
            "charging_icon": " ",
            "discharging_icon": " "
          },
          "cache": {
            "duration": "10m",
            "strategy": "session"
          },
          "leading_diamond": "<background,parentBackground></>",
          "trailing_diamond": "",
          "template": "{{ if not .Error }} {{ .Icon }}{{ .Percentage }}%{{ end }}",
          "foreground": "#111111",
          "background": "accent",
          "type": "battery",
          "style": "diamond",
          "background_templates": [
            "{{if eq \"Discharging\" .State.String}}p:orange{{end}}",
            "{{if eq \"Full\" .State.String}}p:green{{end}}"
          ]
        }
      ]
    }
  ],
  "version": 4
}
